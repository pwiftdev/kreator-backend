CORS_ORIGINS=http://localhost:5173

# Dedicated admin dashboard credentials. These values must only exist on the backend.
ADMIN_DASHBOARD_EMAIL=admin@example.com
ADMIN_DASHBOARD_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
